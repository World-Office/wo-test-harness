# TaskFleet Test Harness - Git Ignore

# Worktrees (isolated task execution environments)
.tf-worktrees/

# State directory (contains ephemeral task status)
state/
  # But keep the .gitkeep if it exists
  !state/.gitkeep

# Results and logs
state/results/
state/logs/

# Generated files
config/tasks.json
config/tasks-harness.json
*.log
*.tmp

# Coverage output
coverage/
*.lcov

# Visual regression baselines (if not committed)
tests/golden/images/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class

# Node.js
node_modules/
package-lock.json

# Test artifacts
*.profdata
*.profraw

# OS
.DS_Store
Thumbs.db
