    { "id": "wopi-checkfileinfo", "oo_ref": "DocService /wopi/files/{id} CheckFileInfo JSON", "wo_impl": "wo-docserver wopi_check_file_info", "status": "shadow", "oracle": "http", "probe": { "method": "GET", "path": "/wopi/files/probe", "expect": "status-4xx" } },
    { "id": "wopi-contents", "oo_ref": "DocService /wopi/files/{id}/contents GET/PUT", "wo_impl": "wo-docserver wopi_get_file / wopi_put_file", "status": "shadow", "oracle": "http", "probe": { "method": "GET", "path": "/wopi/files/probe/contents", "expect": "status-4xx" } },
    { "id": "wopi-locks", "oo_ref": "DocService /wopi/files/{id}/lock|unlock|refreshlock|getlock", "wo_impl": "wo-docserver hosting_wopi_handler catch-all", "status": "canonical", "oracle": "http", "probe": { "method": "GET", "path": "/hosting/discovery", "expect": "status-200", "note": "lock semantics verified via WOPI integration stack" } },
