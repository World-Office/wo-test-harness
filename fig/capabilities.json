    { "id": "editor-ui-pdf", "oo_ref": "web-apps pdf viewer", "wo_impl": "pdfeditor-react + wo-pdf-render", "status": "shadow", "oracle": "census", "probe": { "method": "GET", "path": "/pdf/", "expect": "status-200" } },
    { "id": "editor-ui-diagram", "oo_ref": "web-apps diagram (vsdx)", "wo_impl": "visioeditor-react + wo-route", "status": "shadow", "oracle": "census", "probe": { "method": "GET", "path": "/diagram/", "expect": "status-200" } },
