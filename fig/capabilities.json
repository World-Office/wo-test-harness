    { "id": "editor-ui-word", "oo_ref": "web-apps/apps/documenteditor + sdkjs/word", "wo_impl": "documenteditor-wysiwyg + wo-docserver editor_docs", "status": "shadow", "oracle": "parity-contracts", "probe": { "method": "GET", "path": "/word/", "expect": "ribbon-markers" }, "oracleRef": "server/tests/parity/contract-results.json" },
